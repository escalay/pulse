// The Worker as it is deployed, with the account's own ids left out: copy to wrangler.jsonc and fill them in.
// Request logs are off on purpose: nothing about who sent a report is kept outside the tables in migrations/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escalay-pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": false },
  "d1_databases": [
    { "binding": "DB", "database_name": "escalay-pulse", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ]
}
