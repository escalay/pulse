// The Worker as it is deployed, with the account's own ids left out: copy to wrangler.jsonc and fill them in.
// Request logs are off on purpose: nothing about who sent a report is kept outside the tables in migrations/.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "escalay-pulse",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "workers_dev": false,
  "observability": { "enabled": false },
  // Once a day: the newest release, stars and downloads of each product, and the 13-month roll-up
  "triggers": { "crons": ["17 5 * * *"] },
  // At most 20 reports a minute from one sender; the count lives a minute and is never stored
  "ratelimits": [{ "name": "LIMIT", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } }],
  // The private pages exist only when both are set: the Zero Trust team name and the Access application's audience
  "vars": { "ACCESS_TEAM": "", "ACCESS_AUD": "" },
  "d1_databases": [
    { "binding": "DB", "database_name": "escalay-pulse", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }
  ]
}
